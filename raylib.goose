// 8 bpp
let PIXELFORMAT_COMPRESSED_DXT3_RGBA: i32 = 16;

// 8 bpp
let PIXELFORMAT_COMPRESSED_DXT5_RGBA: i32 = 17;

// 4 bpp
let PIXELFORMAT_COMPRESSED_ETC1_RGB: i32 = 18;

// 4 bpp
let PIXELFORMAT_COMPRESSED_ETC2_RGB: i32 = 19;

// 8 bpp
let PIXELFORMAT_COMPRESSED_ETC2_EAC_RGBA: i32 = 20;

