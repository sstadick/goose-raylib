let PIXELFORMAT_UNCOMPRESSED_GRAYSCALE: i32 = 1;

// 8*2 bpp (2 channels)
let PIXELFORMAT_UNCOMPRESSED_GRAY_ALPHA: i32 = 2;

// 16 bpp
let PIXELFORMAT_UNCOMPRESSED_R5G6B5: i32 = 3;

// 24 bpp
let PIXELFORMAT_UNCOMPRESSED_R8G8B8: i32 = 4;

// 16 bpp (1 bit alpha)
let PIXELFORMAT_UNCOMPRESSED_R5G5B5A1: i32 = 5;

// 16 bpp (4 bit alpha)
let PIXELFORMAT_UNCOMPRESSED_R4G4B4A4: i32 = 6;

// 32 bpp
let PIXELFORMAT_UNCOMPRESSED_R8G8B8A8: i32 = 7;

// 32 bpp (1 channel - float)
let PIXELFORMAT_UNCOMPRESSED_R32: i32 = 8;

// 32*3 bpp (3 channels - float)
let PIXELFORMAT_UNCOMPRESSED_R32G32B32: i32 = 9;

// 32*4 bpp (4 channels - float)
let PIXELFORMAT_UNCOMPRESSED_R32G32B32A32: i32 = 10;

// 16 bpp (1 channel - half float)
let PIXELFORMAT_UNCOMPRESSED_R16: i32 = 11;

// 16*3 bpp (3 channels - half float)
let PIXELFORMAT_UNCOMPRESSED_R16G16B16: i32 = 12;

// 16*4 bpp (4 channels - half float)
let PIXELFORMAT_UNCOMPRESSED_R16G16B16A16: i32 = 13;

// 4 bpp (no alpha)
let PIXELFORMAT_COMPRESSED_DXT1_RGB: i32 = 14;

// 4 bpp (1 bit alpha)
