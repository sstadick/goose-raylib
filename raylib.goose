// No filter, pixel approximation
let TEXTURE_FILTER_POINT: i32 = 0;

// Linear filtering
let TEXTURE_FILTER_BILINEAR: i32 = 1;

// Trilinear filtering (linear with mipmaps)
let TEXTURE_FILTER_TRILINEAR: i32 = 2;

// Anisotropic filtering 4x
let TEXTURE_FILTER_ANISOTROPIC_4X: i32 = 3;

// Anisotropic filtering 8x
let TEXTURE_FILTER_ANISOTROPIC_8X: i32 = 4;

// Anisotropic filtering 16x
let TEXTURE_FILTER_ANISOTROPIC_16X: i32 = 5;

// Repeats texture in tiled mode
let TEXTURE_WRAP_REPEAT: i32 = 0;

// Clamps texture to edge pixel in tiled mode
let TEXTURE_WRAP_CLAMP: i32 = 1;

// Mirrors and repeats the texture in tiled mode
let TEXTURE_WRAP_MIRROR_REPEAT: i32 = 2;

// Mirrors and clamps to border the texture in tiled mode
let TEXTURE_WRAP_MIRROR_CLAMP: i32 = 3;

// Automatically detect layout type
let CUBEMAP_LAYOUT_AUTO_DETECT: i32 = 0;

// Layout is defined by a vertical line with faces
let CUBEMAP_LAYOUT_LINE_VERTICAL: i32 = 1;

// Layout is defined by a horizontal line with faces
let CUBEMAP_LAYOUT_LINE_HORIZONTAL: i32 = 2;

// Layout is defined by a 3x4 cross with cubemap faces
let CUBEMAP_LAYOUT_CROSS_THREE_BY_FOUR: i32 = 3;

// Layout is defined by a 4x3 cross with cubemap faces
let CUBEMAP_LAYOUT_CROSS_FOUR_BY_THREE: i32 = 4;

// Default font generation, anti-aliased
let FONT_DEFAULT: i32 = 0;

// Bitmap font generation, no anti-aliasing
let FONT_BITMAP: i32 = 1;

// SDF font generation, requires external shader
let FONT_SDF: i32 = 2;

// Blend textures considering alpha (default)
let BLEND_ALPHA: i32 = 0;

// Blend textures adding colors
let BLEND_ADDITIVE: i32 = 1;

// Blend textures multiplying colors
let BLEND_MULTIPLIED: i32 = 2;

// Blend textures adding colors (alternative)
let BLEND_ADD_COLORS: i32 = 3;

// Blend textures subtracting colors (alternative)
let BLEND_SUBTRACT_COLORS: i32 = 4;

// Blend premultiplied textures considering alpha
let BLEND_ALPHA_PREMULTIPLY: i32 = 5;

// Blend textures using custom src/dst factors (use rlSetBlendFactors())
let BLEND_CUSTOM: i32 = 6;

// Blend textures using custom rgb/alpha separate src/dst factors (use rlSetBlendFactorsSeparate())
let BLEND_CUSTOM_SEPARATE: i32 = 7;

// No gesture
let GESTURE_NONE: i32 = 0;

// Tap gesture
let GESTURE_TAP: i32 = 1;

// Double tap gesture
let GESTURE_DOUBLETAP: i32 = 2;

// Hold gesture
let GESTURE_HOLD: i32 = 4;

// Drag gesture
let GESTURE_DRAG: i32 = 8;

// Swipe right gesture
let GESTURE_SWIPE_RIGHT: i32 = 16;

// Swipe left gesture
let GESTURE_SWIPE_LEFT: i32 = 32;

// Swipe up gesture
let GESTURE_SWIPE_UP: i32 = 64;

// Swipe down gesture
let GESTURE_SWIPE_DOWN: i32 = 128;

// Pinch in gesture
let GESTURE_PINCH_IN: i32 = 256;

// Pinch out gesture
let GESTURE_PINCH_OUT: i32 = 512;

// Camera custom, controlled by user (UpdateCamera() does nothing)
let CAMERA_CUSTOM: i32 = 0;

// Camera free mode
let CAMERA_FREE: i32 = 1;

// Camera orbital, around target, zoom supported
let CAMERA_ORBITAL: i32 = 2;

// Camera first person
let CAMERA_FIRST_PERSON: i32 = 3;

// Camera third person
let CAMERA_THIRD_PERSON: i32 = 4;

// Perspective projection
let CAMERA_PERSPECTIVE: i32 = 0;

// Orthographic projection
let CAMERA_ORTHOGRAPHIC: i32 = 1;

// Npatch layout: 3x3 tiles
let NPATCH_NINE_PATCH: i32 = 0;

// Npatch layout: 1x3 tiles
let NPATCH_THREE_PATCH_VERTICAL: i32 = 1;

// Npatch layout: 3x1 tiles
let NPATCH_THREE_PATCH_HORIZONTAL: i32 = 2;

// EPSILON
let EPSILON: f32 = 1e-06;

// Initialize window and OpenGL context Unsafe: addresses must have native C layout, alignment, capacity and lifetime. Follow raylib's ownership rules.
extern fn init_window_raw(width: i32, height: i32, title: u64) = "grl_init_window_raw";

// Internal adapter; text arguments must include their trailing NUL.
extern fn _c_init_window(width: i32, height: i32, title: const u8[:]) = "grl__c_init_window";

// Initialize window and OpenGL context
// Text is copied and NUL-terminated for this call; embedded NUL ends the C string.
inline fn init_window(width: i32, height: i32, title: const u8[:]) {
    let z_title = str(title, "\0");
    _c_init_window(width, height, z_title);
}

// Close window and unload OpenGL context
extern fn close_window() = "grl_close_window";

// Check if application should close (KEY_ESCAPE pressed or windows close icon clicked)
extern fn window_should_close() -> bool = "grl_window_should_close";

// Check if window has been initialized successfully
extern fn is_window_ready() -> bool = "grl_is_window_ready";

// Check if window is currently fullscreen
extern fn is_window_fullscreen() -> bool = "grl_is_window_fullscreen";

// Check if window is currently hidden
extern fn is_window_hidden() -> bool = "grl_is_window_hidden";

// Check if window is currently minimized
extern fn is_window_minimized() -> bool = "grl_is_window_minimized";

// Check if window is currently maximized
extern fn is_window_maximized() -> bool = "grl_is_window_maximized";

// Check if window is currently focused
extern fn is_window_focused() -> bool = "grl_is_window_focused";

// Check if window has been resized last frame
extern fn is_window_resized() -> bool = "grl_is_window_resized";

// Check if one specific window flag is enabled
extern fn is_window_state(flag: u32) -> bool = "grl_is_window_state";

// Set window configuration state using flags
extern fn set_window_state(flags: u32) = "grl_set_window_state";

// Clear window configuration state flags
extern fn clear_window_state(flags: u32) = "grl_clear_window_state";

// Toggle window state: fullscreen/windowed, resizes monitor to match window resolution
extern fn toggle_fullscreen() = "grl_toggle_fullscreen";

// Toggle window state: borderless windowed, resizes window to match monitor resolution
extern fn toggle_borderless_windowed() = "grl_toggle_borderless_windowed";

// Set window state: maximized, if resizable
extern fn maximize_window() = "grl_maximize_window";

// Set window state: minimized, if resizable
extern fn minimize_window() = "grl_minimize_window";

// Restore window from being minimized/maximized
extern fn restore_window() = "grl_restore_window";

// Set icon for window (single image, RGBA 32bit)
