let PIXELFORMAT_COMPRESSED_PVRT_RGB: i32 = 21;

// 4 bpp
let PIXELFORMAT_COMPRESSED_PVRT_RGBA: i32 = 22;

// 8 bpp
let PIXELFORMAT_COMPRESSED_ASTC_4x4_RGBA: i32 = 23;

// 2 bpp
