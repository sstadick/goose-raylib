// Set icon for window (multiple images, RGBA 32bit) Unsafe: addresses must have native C layout, alignment, capacity and lifetime. Follow raylib's ownership rules.
extern fn set_window_icons_raw(images: u64, count: i32) = "grl_set_window_icons_raw";

// Set title for window Unsafe: addresses must have native C layout, alignment, capacity and lifetime. Follow raylib's ownership rules.
extern fn set_window_title_raw(title: u64) = "grl_set_window_title_raw";

// Internal adapter; text arguments must include their trailing NUL.
extern fn _c_set_window_title(title: const u8[:]) = "grl__c_set_window_title";

// Set title for window
