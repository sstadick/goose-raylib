// Internal adapter; text arguments must include their trailing NUL.
extern fn _c_load_music_stream(file_name: const u8[:]) -> Music = "grl__c_load_music_stream";

// Load music stream from file
// Text is copied and NUL-terminated for this call; embedded NUL ends the C string.
inline fn load_music_stream(file_name: const u8[:]) -> Music {
    let z_file_name = str(file_name, "\0");
    return _c_load_music_stream(z_file_name);
}

