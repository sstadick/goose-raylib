// Get the human-readable, UTF-8 encoded name of the specified monitor Unsafe: addresses must have native C layout, alignment, capacity and lifetime. Follow raylib's ownership rules.
extern fn get_monitor_name_raw(monitor: i32) -> u64 = "grl_get_monitor_name_raw";

// Internal adapter; text arguments must include their trailing NUL.
extern fn _c_get_monitor_name(monitor: i32) -> u64 = "grl__c_get_monitor_name";

// Get the human-readable, UTF-8 encoded name of the specified monitor
// Returns an owned copy, empty when raylib returns NULL.
inline fn get_monitor_name(monitor: i32) -> u8[>..] {
