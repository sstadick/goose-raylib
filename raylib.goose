extern fn quaternion_divide(q1: Vector4, q2: Vector4) -> Vector4 = "grl_quaternion_divide";

// Calculate linear interpolation between two quaternions
extern fn quaternion_lerp(q1: Vector4, q2: Vector4, amount: f32) -> Vector4 = "grl_quaternion_lerp";

// Calculate slerp-optimized interpolation between two quaternions
extern fn quaternion_nlerp(q1: Vector4, q2: Vector4, amount: f32) -> Vector4 = "grl_quaternion_nlerp";

// Calculates spherical linear interpolation between two quaternions
extern fn quaternion_slerp(q1: Vector4, q2: Vector4, amount: f32) -> Vector4 = "grl_quaternion_slerp";

// as described in the GLTF 2.0 specification: https://registry.khronos.org/glTF/specs/2.0/glTF-2.0.html#interpolation-cubic
extern fn quaternion_cubic_hermite_spline(q1: Vector4, out_tangent1: Vector4, q2: Vector4, in_tangent2: Vector4, t: f32) -> Vector4 = "grl_quaternion_cubic_hermite_spline";

// Calculate quaternion based on the rotation from one vector to another
extern fn quaternion_from_vector3_to_vector3(from_: Vector3, to: Vector3) -> Vector4 = "grl_quaternion_from_vector3_to_vector3";

// Get a quaternion for a given rotation matrix
extern fn quaternion_from_matrix(mat: Matrix) -> Vector4 = "grl_quaternion_from_matrix";

// Get a matrix for a given quaternion
extern fn quaternion_to_matrix(q: Vector4) -> Matrix = "grl_quaternion_to_matrix";

// NOTE: Angle must be provided in radians
extern fn quaternion_from_axis_angle(axis: Vector3, angle: f32) -> Vector4 = "grl_quaternion_from_axis_angle";

// Get the rotation angle and axis for a given quaternion Unsafe: addresses must have native C layout, alignment, capacity and lifetime. Follow raylib's ownership rules.
extern fn quaternion_to_axis_angle_raw(q: Vector4, out_axis: u64, out_angle: u64) = "grl_quaternion_to_axis_angle_raw";

// Internal adapter; text arguments must include their trailing NUL.
extern fn _c_quaternion_to_axis_angle(q: Vector4, out_axis: Vector3&, out_angle: f32&) = "grl__c_quaternion_to_axis_angle";

// Get the rotation angle and axis for a given quaternion
inline fn quaternion_to_axis_angle(q: Vector4, out_axis: Vector3&, out_angle: f32&) {
    _c_quaternion_to_axis_angle(q, out_axis, out_angle);
}

// NOTE: Rotation order is ZYX
extern fn quaternion_from_euler(pitch: f32, yaw: f32, roll: f32) -> Vector4 = "grl_quaternion_from_euler";

// NOTE: Angles are returned in a Vector3 struct in radians
extern fn quaternion_to_euler(q: Vector4) -> Vector3 = "grl_quaternion_to_euler";

// Transform a quaternion given a transformation matrix
extern fn quaternion_transform(q: Vector4, mat: Matrix) -> Vector4 = "grl_quaternion_transform";

// Check whether two given quaternions are almost equal
extern fn quaternion_equals(p: Vector4, q: Vector4) -> i32 = "grl_quaternion_equals";

// TODO: This function is not following raymath conventions defined in header: NOT self-contained
extern fn matrix_compose(translation: Vector3, rotation: Vector4, scale: Vector3) -> Matrix = "grl_matrix_compose";

// TODO: This function is not following raymath conventions defined in header: NOT self-contained Unsafe: addresses must have native C layout, alignment, capacity and lifetime. Follow raylib's ownership rules.
extern fn matrix_decompose_raw(mat: Matrix, translation: u64, rotation: u64, scale: u64) = "grl_matrix_decompose_raw";

// Internal adapter; text arguments must include their trailing NUL.
extern fn _c_matrix_decompose(mat: Matrix, translation: Vector3&, rotation: Vector4&, scale: Vector3&) = "grl__c_matrix_decompose";

// TODO: This function is not following raymath conventions defined in header: NOT self-contained
inline fn matrix_decompose(mat: Matrix, translation: Vector3&, rotation: Vector4&, scale: Vector3&) {
    _c_matrix_decompose(mat, translation, rotation, scale);
}
